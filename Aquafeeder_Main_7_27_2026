float measureDistance() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);
  
  long duration = pulseIn(ECHO_PIN, HIGH, 30000);
  float distance = (duration * 0.0343) / 2;
  
  if (duration == 0) return -1;
  return distance;
}

void checkFeedLevel() {
  float distance = measureDistance();
  
  if (distance < 0 || distance < 30) {
    currentFeedLevel = 100.0;
  } else {
    if (distance > RESERVOIR_HEIGHT) distance = RESERVOIR_HEIGHT;
    currentFeedLevel = 100.0 - ((distance / RESERVOIR_HEIGHT) * 100.0);
    if (currentFeedLevel > 100.0) currentFeedLevel = 100.0;
    if (currentFeedLevel < 0.0) currentFeedLevel = 0.0;
  }
  
  int feedLevelInt = (int)currentFeedLevel;
  if (abs(feedLevelInt - lastSentFeedLevel) > 5) {
    Blynk.virtualWrite(feed_level_virtual_pin, feedLevelInt);
    lastSentFeedLevel = feedLevelInt;
  }
  
  if (distance >= LOW_FEED_THRESHOLD) {
    if (!lowFeedAlert) {
      lowFeedAlert = true;
      Blynk.virtualWrite(low_feed_alert_virtual_pin, 255);
      terminalPrint("ALERT: Feed LOW!");
    }
  } else {
    if (lowFeedAlert) {
      lowFeedAlert = false;
      Blynk.virtualWrite(low_feed_alert_virtual_pin, 0);
    }
  }
}

void checkSchedules() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) return;
  
  int currentHour = timeinfo.tm_hour;
  int currentMinute = timeinfo.tm_min;
  
  if (scheduler1_hour == currentHour && scheduler1_minute == currentMinute && !scheduler1_triggered) {
    scheduler1_triggered = true;
    terminalPrint("SCHEDULER 1 TRIGGERED");
    
    if (currentMode != MODE_MANUAL && !blowerRunning) {
      startFeedingByMode();
    }
  }
  if (scheduler1_minute != currentMinute) {
    scheduler1_triggered = false;
  }
  
  if (scheduler2_hour == currentHour && scheduler2_minute == currentMinute && !scheduler2_triggered) {
    scheduler2_triggered = true;
    terminalPrint("SCHEDULER 2 TRIGGERED");
    
    if (currentMode != MODE_MANUAL && !blowerRunning) {
      startFeedingByMode();
    }
  }
  if (scheduler2_minute != currentMinute) {
    scheduler2_triggered = false;
  }
  
  if (scheduler3_hour == currentHour && scheduler3_minute == currentMinute && !scheduler3_triggered) {
    scheduler3_triggered = true;
    terminalPrint("SCHEDULER 3 TRIGGERED");
    
    if (currentMode != MODE_MANUAL && !blowerRunning) {
      startFeedingByMode();
    }
  }
  if (scheduler3_minute != currentMinute) {
    scheduler3_triggered = false;
  }
}

void startFeedingByMode() {
  blowerRunning = true;
  dispensedAmountKg = 0.0;
  assumedDispense = false;   // reset load-cell fallback flag each feeding
  assumedTotalKg = 0.0;      // reset assumed accumulator each feeding
  feedingState = MEASURING_START;
  stateStartTime = millis();
  
  String modeName;
  switch(currentMode) {
    case MODE_AUTO: modeName = "AUTO"; break;
    case MODE_AD_LIBITUM: modeName = "AD LIBITUM"; break;
    case MODE_WEIGHT_BASED: modeName = "WEIGHT BASED"; break;
  }
  
  terminalPrint("=== FEEDING STARTED ===");
  terminalPrint("Mode: " + modeName);
  terminalPrint("Target: " + String(targetFeedAmount, 1) + " kg");
}

void runFeedingStateMachine() {
  unsigned long currentTime = millis();
  unsigned long elapsed = currentTime - stateStartTime;
  
  switch(feedingState) {
    
    case MEASURING_START:
      feedingStartWeight = getStableWeight();
      terminalPrint("Start: " + String(feedingStartWeight, 1) + " kg");
      feedingState = BLOWER_START;
      stateStartTime = currentTime;
      break;
      
    case BLOWER_START:
      digitalWrite(blower_pin, HIGH);
      terminalPrint("Blower ON");
      feedingState = VALVE_OPENING;
      stateStartTime = currentTime;
      break;
      
    case VALVE_OPENING:
      if (elapsed < 5000) break;
      analogWrite(valve_open_pin, 255);
      analogWrite(valve_close_pin, 0);
      terminalPrint("Valve opening...");
      feedingState = DISPENSING;
      stateStartTime = currentTime;
      break;
      
    case DISPENSING:
      if (elapsed < (VALVE_OPEN_TIME + DISPENSE_TIME) * 1000) break;
      analogWrite(valve_open_pin, 0);
      analogWrite(valve_close_pin, 0);
      feedingState = VALVE_CLOSING;
      stateStartTime = currentTime;
      break;
      
    case VALVE_CLOSING:
      analogWrite(valve_open_pin, 0);
      analogWrite(valve_close_pin, 255);
      terminalPrint("Valve closing...");
      feedingState = WAITING_SETTLE;
      stateStartTime = currentTime;
      break;
      
    case WAITING_SETTLE:
      if (elapsed < VALVE_CLOSE_TIME * 1000) break;
      
      // STOP EVERYTHING FIRST
      analogWrite(valve_open_pin, 0);
      analogWrite(valve_close_pin, 0);
      digitalWrite(blower_pin, LOW);  // ← TURN OFF BLOWER!
      terminalPrint("Blower OFF - waiting for scale to settle...");
      
      feedingState = MEASURING_END;
      stateStartTime = currentTime;
      break;
      
    case MEASURING_END:  // Wait for vibrations to stop
      // Wait 8 seconds for system to stabilize
      if (elapsed < 8000) {
        static unsigned long lastCountdown = 0;
        if (currentTime - lastCountdown > 1000) {
          lastCountdown = currentTime;
          int remaining = 8 - (elapsed / 1000);
          terminalPrint("Stabilizing... " + String(remaining) + "s");
        }
        break;
      }
      
      terminalPrint("Reading scale...");
      currentReservoirWeight = getStableWeight();
      
      // If the scale is online, compute the real cumulative dispense
      if (scaleOnline) {
        dispensedAmountKg = feedingStartWeight - currentReservoirWeight;
      }
      
      // Load cell unreliable this cycle? Assume +200 g and KEEP FEEDING
      // (do NOT stop the session - accumulate and fall through to camera/target)
      if (!scaleOnline || dispensedAmountKg < 0 || dispensedAmountKg > 5.0) {
        assumedDispense = true;
        assumedTotalKg += ASSUMED_DISPENSE_KG;     // +200 g this cycle
        dispensedAmountKg = assumedTotalKg;         // use assumed running total
        terminalPrint("Load cell unreliable - assuming +200 g this cycle");
        terminalPrint("Assumed session total: " + String(dispensedAmountKg, 1) + " kg");
      } else {
        terminalPrint("Dispensed this cycle: " + String(dispensedAmountKg, 1) + " kg");
      }
      
      Blynk.virtualWrite(dispensed_weight_virtual_pin, dispensedAmountKg);
      
      // Stop when target/max reached.
      // AUTO & WEIGHT_BASED: this is the feed target.
      // AD LIBITUM: this acts as a hard SAFETY CAP so a stuck "eating"
      // camera + dead load cell can't feed forever.
      if (dispensedAmountKg >= targetFeedAmount) {
        terminalPrint("Target/max reached (" + String(targetFeedAmount, 1) + " kg) - stopping");
        stopFeeding();
        return;
      }
      
      // Continue: weight-based loops immediately, others check camera
      if (currentMode == MODE_WEIGHT_BASED) {
        feedingState = BLOWER_START;  // Continue feeding
        stateStartTime = currentTime;
      } else {
        terminalPrint("Waiting " + String(cameraCheckDelay) + "s...");
        feedingState = CHECKING_CAMERA;
        stateStartTime = currentTime;
      }
      break;
      
    case CHECKING_CAMERA:
      if (elapsed < cameraCheckDelay * 1000) break;
      
      int cameraSignal = getCameraReading();  // respects override
      if (cameraOverride) {
        terminalPrint("Camera OVERRIDE active");
      }
      if (cameraSignal == HIGH) {
        terminalPrint("Fish eating - continue");
        feedingState = BLOWER_START;
        stateStartTime = currentTime;
      } else {
        terminalPrint("Fish stopped - ending");
        stopFeeding();
      }
      break;
  }
}

void stopFeeding() {
  digitalWrite(blower_pin, LOW);
  analogWrite(valve_open_pin, 0);
  analogWrite(valve_close_pin, 0);
  blowerRunning = false;
  feedingState = IDLE;
  
  if (assumedDispense || !scaleOnline) {
    // Load cell unreliable - dispensedAmountKg already holds the assumed running total
    dispensedAmountKg = assumedTotalKg;
    terminalPrint("Sensor unreliable - logging assumed total: " + String(dispensedAmountKg, 1) + " kg");
  } else {
    currentReservoirWeight = getStableWeight();
    dispensedAmountKg = feedingStartWeight - currentReservoirWeight;
  }
  
  totalFeedDispensed += dispensedAmountKg;
  preferences.putFloat("totalFeed", totalFeedDispensed);
  
  calculateBiomass();
  
  assumedDispense = false;  // reset for next feeding
  assumedTotalKg = 0.0;     // reset accumulator for next feeding
  
  terminalPrint("=== COMPLETE ===");
  terminalPrint("Dispensed: " + String(dispensedAmountKg, 1) + " kg");
  terminalPrint("Total: " + String(totalFeedDispensed, 1) + " kg");
  terminalPrint("Reservoir: " + String(currentReservoirWeight, 1) + " kg");
}
