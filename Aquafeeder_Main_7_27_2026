// ===== NON-BLOCKING WEIGHT READ =====
// Never hangs: if HX711 doesn't signal ready within timeout, returns last known value.
float getStableWeight() {
  if (!scale.wait_ready_timeout(HX711_READY_TIMEOUT)) {
    scaleOnline = false;
    return currentReservoirWeight;  // last known value, don't block
  }
  scaleOnline = true;
  float lbs = scale.get_units();
  float kg = lbs * 0.453592;
  return kg;
}

// ===== SAFE TARE (won't hang if HX711 dead) =====
bool safeTare() {
  if (!scale.wait_ready_timeout(1000)) {
    scaleOnline = false;
    terminalPrint("HX711 offline - tare skipped");
    return false;
  }
  scale.tare();
  scaleOnline = true;
  return true;
}

// ===== CAMERA READING (respects override) =====
int getCameraReading() {
  if (cameraOverride) {
    return cameraOverrideValue ? HIGH : LOW;
  }
  return digitalRead(camera_pin);
}

void setup()
{
