  Serial.println("Population: " + String(tilapiaPopulation));

  WiFi.begin(ssid, pass);
  Serial.print("Connecting WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi OK");

  configTime(gmtOffset_sec, daylightOffset_sec, ntpServer);
  delay(2000);

  Blynk.config(BLYNK_AUTH_TOKEN);
  Blynk.connect();

  pinMode(blower_pin, OUTPUT);
  pinMode(valve_open_pin, OUTPUT);
  pinMode(valve_close_pin, OUTPUT);
  pinMode(camera_pin, INPUT);
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  digitalWrite(blower_pin, LOW);
  digitalWrite(valve_open_pin, LOW);
  digitalWrite(valve_close_pin, LOW);

  Serial.println("Initializing HX711...");
  scale.begin(LOADCELL_DOUT_PIN, LOADCELL_SCK_PIN);
  scale.set_scale(CALIBRATION_FACTOR);

  // Timeout guard - don't hang setup if load cell is bad/disconnected
  if (scale.wait_ready_timeout(1000)) {
    scale.tare();
    scaleOnline = true;
    Serial.println("Load cell ready");
  } else {
    scaleOnline = false;
    Serial.println("HX711 NOT responding - skipping tare, running WITHOUT load cell");
  }

  currentReservoirWeight = getStableWeight();
  Serial.print("Weight: ");
  Serial.print(currentReservoirWeight, 1);
  Serial.println(" kg");

  calculateBiomass();

  Serial.println("\n=== Ready ===");
  terminalPrint("=== Smart AquaFeeder Ready ===");
  if (!scaleOnline) terminalPrint("HX711 offline - load cell disregarded");
  terminalPrint("Total feed: " + String(totalFeedDispensed, 2) + " kg");
  terminalPrint("Population: " + String(tilapiaPopulation));
}

void loop()
{
  Blynk.run();
  
  unsigned long currentMillis = millis();
  
  if (currentMillis - lastScheduleCheck >= SCHEDULE_INTERVAL) {
    lastScheduleCheck = currentMillis;
    checkSchedules();
  }
  
  if (currentMillis - lastCameraUpdate >= CAMERA_INTERVAL) {
    lastCameraUpdate = currentMillis;
    updateCameraStatus();
  }
  
  if (currentMillis - lastFeedLevelCheck >= FEED_LEVEL_INTERVAL) {
    lastFeedLevelCheck = currentMillis;
    checkFeedLevel();
  }
  
  if (currentMillis - lastWeightDisplay >= WEIGHT_DISPLAY_INTERVAL && !blowerRunning) {
    lastWeightDisplay = currentMillis;
    updateWeightDisplay();
  }
  
  if (blowerRunning) {
    runFeedingStateMachine();
  }
}

void terminalPrint(String message) {
  Serial.println(message);
  terminal.println(message);
  terminal.flush();
}

void calculateBiomass() {
  float weightGain = totalFeedDispensed / FCR;
  currentWeightPerTilapia = initialWeight + (weightGain / initialPopulation);
  estimatedBiomass = currentWeightPerTilapia * tilapiaPopulation;
  
  if (abs(estimatedBiomass - lastSentBiomass) > 0.5) {
    Blynk.virtualWrite(estimated_biomass_virtual_pin, estimatedBiomass);
    Blynk.virtualWrite(weight_per_fish_virtual_pin, currentWeightPerTilapia * 1000);
    lastSentBiomass = estimatedBiomass;
  }
}

void updateWeightDisplay() {
  currentReservoirWeight = getStableWeight();
  
  if (abs(currentReservoirWeight - lastSentWeight) > 0.2) {
    String status = "Weight: " + String(currentReservoirWeight, 1) + " kg";
    
    if (!scaleOnline) {
      status += " - HX711 OFFLINE";
    } else if (currentReservoirWeight < -2.0) {
      status += " - CHECK!";
    } else if (currentReservoirWeight < 5) {
      status += " - LOW!";
    }
    
    Serial.println(status);
    
    static unsigned long lastTerminalPrint = 0;
    if (millis() - lastTerminalPrint > 15000) {
      terminalPrint(status);
      lastTerminalPrint = millis();
    }
    
    lastSentWeight = currentReservoirWeight;
  }
}

