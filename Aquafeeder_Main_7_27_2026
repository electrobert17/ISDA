BLYNK_WRITE(terminal_virtual_pin) {
  String input = param.asStr();
  
  if (input.startsWith("CAL ")) {
    float knownWeight = input.substring(4).toFloat();
    
    if (knownWeight <= 0 || knownWeight > 100) {
      terminalPrint("Invalid weight");
      return;
    }
    
    if (!scaleOnline && !scale.wait_ready_timeout(1000)) {
      terminalPrint("HX711 offline - cannot calibrate");
      return;
    }
    
    terminalPrint("Calibrating...");
    
    float reading = getStableWeight();
    if (reading == 0) {
      terminalPrint("Zero reading - aborting");
      return;
    }
    CALIBRATION_FACTOR = CALIBRATION_FACTOR * (knownWeight / reading);
    scale.set_scale(CALIBRATION_FACTOR);
    preferences.putFloat("calibration", CALIBRATION_FACTOR);
    
    delay(1000);
    float measuredWeight = getStableWeight();
    
    terminalPrint("=== COMPLETE ===");
    terminalPrint("Factor: " + String(CALIBRATION_FACTOR, 1));
    terminalPrint("Measured: " + String(measuredWeight, 1) + " kg");
  }
  else if (input.equals("TARE")) {
    if (safeTare()) {          // won't hang if HX711 dead
      delay(500);
      terminalPrint("Scale zeroed");
      float newWeight = getStableWeight();
      terminalPrint("Reading: " + String(newWeight, 1) + " kg");
    }
  }
  else if (input.equals("STATUS")) {
    struct tm timeinfo;
    getLocalTime(&timeinfo);
    
    terminalPrint("\n=== STATUS ===");
    terminalPrint("Time: " + String(timeinfo.tm_hour) + ":" + String(timeinfo.tm_min));
    terminalPrint("Mode: " + String(currentMode));
    terminalPrint("Blower: " + String(blowerRunning ? "ON" : "OFF"));
    terminalPrint("Target: " + String(targetFeedAmount, 1) + " kg");
    terminalPrint("Weight: " + String(currentReservoirWeight, 1) + " kg");
    terminalPrint("HX711: " + String(scaleOnline ? "ONLINE" : "OFFLINE"));
    terminalPrint("Camera: " + String(cameraOverride ? "MANUAL" : "LIVE"));
    terminalPrint("==============");
  }
  else if (input.equals("HELP")) {
    terminalPrint("\n=== COMMANDS ===");
    terminalPrint("CAL 10.0 - Calibrate");
    terminalPrint("TARE - Zero scale");
    terminalPrint("STATUS - Show info");
    terminalPrint("HELP - This help");
    terminalPrint("================");
  }
}

